    { "pattern": "ts.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "qr.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "img.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "crop.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "mark.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "gif.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "slice.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "card.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "cover.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "words.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "jianfan.itzhouq.cn/*", "zone_name": "itzhouq.cn" },
    { "pattern": "rmb.itzhouq.cn/*", "zone_name": "itzhouq.cn" }
  ],
  "observability": { "enabled": true }
}
